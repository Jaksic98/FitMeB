# Copy this file to .env and fill in real values

# DATABASE
POSTGRES_URL=jdbc:postgresql://localhost:5432/fitme
POSTGRES_USER=fitme
POSTGRES_PASSWORD=fitme
POSTGRES_DB=fitme

# JWT
SECRET_KEY=038154355bfea81e5c8bb69ad118ff56edc10f2abc0888dbc1fba753cda144a3

# JWT cookie flags - defaults (true / None) are correct once HTTPS is up.
# Browsers drop Secure cookies sent over plain HTTP, so for a temporary
# smoke test against http://<server-ip>:8080 (before Caddy/HTTPS is live),
# set JWT_COOKIE_SECURE=false and JWT_COOKIE_SAME_SITE=Lax, then revert
# both once the real domain + HTTPS is serving traffic.
JWT_COOKIE_SECURE=
JWT_COOKIE_SAME_SITE=

# CORS - comma-separated list of allowed frontend origins, defaults to http://localhost:5173
# Add a tunnel URL here (e.g. ngrok) temporarily for phone testing, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://xxxx.ngrok-free.dev
CORS_ALLOWED_ORIGINS=

# WHATSAPP PROVIDER - infobip | meta | noop (default noop = poruke samo idu u log)
WHATSAPP_PROVIDER=

# INFOBIP (WhatsApp) - koristi se kad je WHATSAPP_PROVIDER=infobip
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_SENDER=

# META WHATSAPP CLOUD API - koristi se kad je WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=

#Excel
#EXCEL_EXPORT_PATH=/Downloads/Excel